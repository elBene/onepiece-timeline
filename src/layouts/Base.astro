---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/header.css';
import '../styles/horizontal.css';
import '../styles/controls.css';
import '../styles/modal.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Linha do tempo dos acontecimentos do mundo de One Piece, com proteção contra spoilers.' } = Astro.props;
const icon = `${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/{2,}/g, '/');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ecebe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f11" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={icon} />
    <title>{title}</title>
    <script is:inline>
      // Aplica o tema antes da pintura, para não piscar.
      (function () {
        var t = null;
        try { t = localStorage.getItem('op-timeline:theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <slot />
      <footer class="foot">
        <p><b>Versão em desenvolvimento.</b> Eventos marcados como rascunho e capítulos com “≈” ainda estão sendo conferidos nas fontes.</p>
        <p>Projeto de fã, sem fins oficiais. One Piece pertence a Eiichiro Oda, Shueisha e Toei Animation. Os textos são resumos próprios e não reproduzem a obra.</p>
      </footer>
    </div>
  </body>
</html>
