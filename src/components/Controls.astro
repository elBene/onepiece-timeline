---
import { data } from '../lib/data';
const tagEntries = Object.entries(data.tags);
---
<section class="bar" aria-label="Controles da linha do tempo" data-controls data-total={data.events.length}>
  <div class="row">
    <span class="lbl" id="lbl-axis">Ordem</span>
    <div class="seg" role="group" aria-labelledby="lbl-axis" data-group="axis">
      <button type="button" data-v="chrono" aria-pressed="true">Ordem da história</button>
      <button type="button" data-v="pub" aria-pressed="false">Ordem de publicação</button>
    </div>
    <span class="count" data-count aria-live="polite"></span>
  </div>
  <div class="row">
    <span class="lbl" id="lbl-zoom">Zoom</span>
    <div class="seg" role="group" aria-labelledby="lbl-zoom" data-group="zoom">
      <button type="button" data-v="1" aria-pressed="false">Eras</button>
      <button type="button" data-v="2" aria-pressed="false">Marcos</button>
      <button type="button" data-v="3" aria-pressed="true">Eventos</button>
      <button type="button" data-v="4" aria-pressed="false">Tudo</button>
    </div>
  </div>
  <div class="row">
    <span class="lbl" id="lbl-tags">Filtro</span>
    <div class="chips" role="group" aria-labelledby="lbl-tags" data-group="tags">
      {tagEntries.map(([id, name]) => (
        <button type="button" class="chip" data-k={id} aria-pressed="false">{name}</button>
      ))}
    </div>
  </div>
  <div class="row">
    <span class="lbl" id="lbl-spoil">Spoilers</span>
    <label class="spoil">
      <input type="checkbox" data-spoil-on aria-describedby="lbl-spoil" />
      Esconder o que vem depois do capítulo
    </label>
    <label class="spoil">
      <input type="number" data-spoil-ch min="1" max="1200" value="100" disabled aria-label="Último capítulo lido" />
    </label>
  </div>
</section>

<script>
  import { store, getTimelineApi, RENDERED_EVENT } from '../lib/app';
  import type { Zoom, Axis } from '../lib/state';

  const root = document.querySelector<HTMLElement>('[data-controls]')!;
  const total = Number(root.dataset.total);
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const spoilOn = root.querySelector<HTMLInputElement>('[data-spoil-on]')!;
  const spoilCh = root.querySelector<HTMLInputElement>('[data-spoil-ch]')!;

  function press(group: string, value: string) {
    root
      .querySelectorAll<HTMLElement>(`[data-group="${group}"] button`)
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === value)));
  }

  function updateCount(shown: number) {
    const s = store.get();
    count.textContent =
      s.zoom === 1 ? 'visão geral de eras e sagas' : `${shown} de ${total} eventos exibidos`;
  }
  document.addEventListener(RENDERED_EVENT, (e) => updateCount((e as CustomEvent<{ shown: number }>).detail.shown));
  const api = getTimelineApi();
  if (api) updateCount(api.getOrder().length);

  root.querySelector('[data-group="axis"]')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('button');
    if (!b) return;
    press('axis', b.dataset.v!);
    store.set({ axis: b.dataset.v as Axis });
  });
  root.querySelector('[data-group="zoom"]')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('button');
    if (!b) return;
    press('zoom', b.dataset.v!);
    store.set({ zoom: Number(b.dataset.v) as Zoom });
  });
  root.querySelector('[data-group="tags"]')!.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('button');
    if (!b) return;
    const tags = new Set(store.get().tags);
    const k = b.dataset.k!;
    if (tags.has(k)) tags.delete(k);
    else tags.add(k);
    b.setAttribute('aria-pressed', String(tags.has(k)));
    store.set({ tags });
  });
  spoilOn.addEventListener('change', () => {
    spoilCh.disabled = !spoilOn.checked;
    store.set({ spoilerOn: spoilOn.checked });
  });
  // Espera o usuário parar de digitar: cada mudança refaz a corda.
  let chTimer: ReturnType<typeof setTimeout> | undefined;
  spoilCh.addEventListener('input', () => {
    clearTimeout(chTimer);
    chTimer = setTimeout(() => {
      const v = parseInt(spoilCh.value, 10);
      const next = Number.isNaN(v) ? 0 : v;
      if (next !== store.get().lastChapter) store.set({ lastChapter: next });
    }, 250);
  });
</script>
