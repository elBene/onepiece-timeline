---
// Folha de transmissão. O conteúdo é preenchido no cliente a partir de um modelo já
// censurado (src/lib/modal.ts), então eventos ocultos nunca expõem o texto real.
---
<div class="modal" data-modal hidden role="dialog" aria-modal="true" aria-labelledby="m-title">
  <article class="m-card" data-card>
    <header class="m-head">
      <button type="button" class="icon-btn m-close" data-close aria-label="Fechar">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.5 6.5l11 11M17.5 6.5l-11 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </header>
    <div class="m-body" data-body>
      <h2 id="m-title" data-title></h2>
      <p class="m-when mono"><span class="m-conf" data-conf aria-hidden="true"></span><span data-when></span><span class="m-note" data-stamp-note></span></p>
      <p class="m-ribbon" data-ribbon></p>
      <div class="m-static static" data-static aria-hidden="true" hidden></div>
      <p class="m-sum" data-sum></p>
      <p class="m-more" data-more></p>
      <ul class="m-tags" data-tags></ul>
      <dl class="m-facts" data-facts></dl>
    </div>
    <footer class="m-nav">
      <button type="button" class="btn btn-quiet" data-prev>Anterior</button>
      <span class="mono" data-pos></span>
      <button type="button" class="btn btn-quiet" data-next>Próxima</button>
    </footer>
  </article>
</div>

<script>
  import { data } from '../lib/data';
  import { store, getTimelineApi } from '../lib/app';
  import { OPEN_EVENT } from './timeline/mount';
  import { toModalView } from '../lib/modal';
  import { h } from '../lib/dom';

  const modal = document.querySelector<HTMLElement>('[data-modal]')!;
  const card = modal.querySelector<HTMLElement>('[data-card]')!;
  const body = modal.querySelector<HTMLElement>('[data-body]')!;
  const $ = (s: string) => modal.querySelector<HTMLElement>(s)!;
  const prevBtn = $('[data-prev]') as HTMLButtonElement;
  const nextBtn = $('[data-next]') as HTMLButtonElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let currentId: string | null = null;
  let lastFocus: HTMLElement | null = null;
  /** Anterior/Próxima percorrem só o que o leitor pode ler. */
  let order: string[] = [];

  function fill(id: string) {
    const v = toModalView(data, store.get(), id);
    if (!v) return false;
    $('[data-ribbon]').textContent = v.ribbon;
    $('[data-title]').textContent = v.title;
    $('[data-when]').textContent = v.when;
    $('[data-stamp-note]').textContent = v.stampNote;
    $('[data-conf]').className = `m-conf conf-${v.conf}`;
    $('[data-conf]').hidden = v.hidden;
    $('[data-static]').hidden = !v.hidden;
    $('[data-sum]').textContent = v.sum;
    $('[data-more]').textContent = v.more;
    $('[data-more]').hidden = !v.more;
    $('[data-tags]').replaceChildren(...v.tags.map((t) => h('li', {}, [t])));
    $('[data-facts]').replaceChildren(
      ...v.facts.map((f) => h('div', {}, [h('dt', {}, [f.label]), h('dd', {}, [f.value])])),
    );
    const i = order.indexOf(id);
    $('[data-pos]').textContent = i >= 0 ? `${i + 1} de ${order.length}` : '';
    prevBtn.disabled = i <= 0;
    nextBtn.disabled = i < 0 || i >= order.length - 1;
    card.classList.toggle('is-hidden', v.hidden);
    currentId = id;
    body.scrollTop = 0;
    return true;
  }

  function open(id: string, origin: HTMLElement | null) {
    const wasOpen = !modal.hidden;
    if (!wasOpen) {
      const api = getTimelineApi();
      const readable = api?.getReadable() ?? [];
      // Um evento oculto aberto direto entra na lista só para ele mesmo.
      order = readable.includes(id) ? readable : [id];
      lastFocus = origin ?? (document.activeElement as HTMLElement | null);
    }
    if (!fill(id)) return;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    if (!wasOpen) {
      setBackgroundInert(true);
      $('[data-close]').focus();
    } else if (!reduce.matches) {
      card.classList.remove('swap');
      void card.offsetWidth;
      card.classList.add('swap');
    }
  }

  /** Com a folha aberta, o resto da página não recebe foco nem aparece para leitores de tela. */
  function setBackgroundInert(on: boolean) {
    document.querySelectorAll<HTMLElement>('.top, main, .foot, .skip').forEach((el) => (el.inert = on));
    document.body.toggleAttribute('data-modal-open', on);
  }

  function close() {
    modal.hidden = true;
    document.body.style.overflow = '';
    setBackgroundInert(false);
    // Devolve o foco ao evento que estava aberto (pode ter mudado com Anterior/Próxima).
    const api = getTimelineApi();
    if (currentId && api) api.focusEvent(currentId);
    else if (lastFocus && document.contains(lastFocus)) lastFocus.focus();
    currentId = null;
    lastFocus = null;
  }

  function step(d: number) {
    if (!currentId) return;
    const n = order.indexOf(currentId) + d;
    if (n < 0 || n >= order.length) return;
    open(order[n]!, null);
    getTimelineApi()?.centerOn(order[n]!);
  }

  document.addEventListener(OPEN_EVENT, (e) => {
    const { id, origin } = (e as CustomEvent<{ id: string; origin: HTMLElement }>).detail;
    open(id, origin);
  });
  modal.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t === modal || t.closest('[data-close]')) close();
  });
  prevBtn.addEventListener('click', () => step(-1));
  nextBtn.addEventListener('click', () => step(1));

  document.addEventListener('keydown', (e) => {
    if (modal.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'Tab') {
      // Foco preso na folha.
      const f = [...modal.querySelectorAll<HTMLElement>('button:not([disabled])')];
      if (!f.length) return;
      const first = f[0]!;
      const last = f[f.length - 1]!;
      if (!modal.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
