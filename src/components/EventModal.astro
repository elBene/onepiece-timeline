---
// Casca do popup em pergaminho. O conteúdo é preenchido no cliente a partir de um
// modelo já censurado (src/lib/modal.ts), então eventos ocultos nunca expõem o texto real.
---
<div class="modal" data-modal hidden role="dialog" aria-modal="true" aria-labelledby="m-title">
  <div class="modal-card">
    <div class="paper" data-paper>
      <button type="button" class="m-close" data-close aria-label="Fechar">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="m-ribbon" data-ribbon></div>
      <h2 id="m-title" data-title></h2>
      <div class="m-stamp"><span data-when></span><small data-stamp-note></small></div>
      <p class="m-sum" data-sum></p>
      <p class="m-more" data-more></p>
      <div class="m-tags" data-tags></div>
      <dl class="m-src" data-facts></dl>
      <div class="m-nav">
        <button type="button" data-prev>← Anterior</button>
        <span data-pos></span>
        <button type="button" data-next>Próximo →</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { data } from '../lib/data';
  import { store, getTimelineApi } from '../lib/app';
  import { OPEN_EVENT } from './timeline/mount';
  import { toModalView } from '../lib/modal';
  import { h } from '../lib/dom';

  const modal = document.querySelector<HTMLElement>('[data-modal]')!;
  const paper = modal.querySelector<HTMLElement>('[data-paper]')!;
  const $ = (s: string) => modal.querySelector<HTMLElement>(s)!;
  const prevBtn = $('[data-prev]') as HTMLButtonElement;
  const nextBtn = $('[data-next]') as HTMLButtonElement;
  let currentId: string | null = null;
  let lastFocus: HTMLElement | null = null;
  let order: string[] = [];

  // Borda rasgada do pergaminho.
  {
    const pts: string[] = [];
    const n = 34;
    for (let i = 0; i <= n; i++) pts.push(`${((i * 100) / n).toFixed(2)}% ${(2 + Math.abs(Math.sin(i * 2.7)) * 5).toFixed(1)}px`);
    for (let i = n; i >= 0; i--)
      pts.push(`${((i * 100) / n).toFixed(2)}% calc(100% - ${(2 + Math.abs(Math.cos(i * 3.1)) * 5).toFixed(1)}px)`);
    paper.style.clipPath = `polygon(${pts.join(',')})`;
  }

  function fill(id: string) {
    const v = toModalView(data, store.get(), id);
    if (!v) return false;
    $('[data-ribbon]').textContent = v.ribbon;
    $('[data-title]').textContent = v.title;
    $('[data-when]').textContent = v.when;
    $('[data-stamp-note]').textContent = v.stampNote;
    $('[data-sum]').textContent = v.sum;
    $('[data-more]').textContent = v.more;
    $('[data-tags]').replaceChildren(...v.tags.map((t) => h('span', {}, [t])));
    $('[data-facts]').replaceChildren(
      ...v.facts.map((f) => h('div', {}, [h('dt', {}, [f.label]), h('dd', {}, [f.value])])),
    );
    const i = order.indexOf(id);
    $('[data-pos]').textContent = i >= 0 ? `${i + 1} de ${order.length}` : '';
    prevBtn.disabled = i <= 0;
    nextBtn.disabled = i < 0 || i >= order.length - 1;
    currentId = id;
    paper.scrollTop = 0;
    return true;
  }

  function open(id: string, origin: HTMLElement | null) {
    const wasOpen = !modal.hidden;
    if (!wasOpen) {
      order = getTimelineApi()?.getOrder() ?? [];
      lastFocus = origin ?? (document.activeElement as HTMLElement | null);
    }
    if (!fill(id)) return;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    if (!wasOpen) $('[data-close]').focus();
  }

  function close() {
    modal.hidden = true;
    document.body.style.overflow = '';
    // Devolve o foco ao elemento do evento que estava aberto (pode ter mudado com Anterior/Próximo).
    const current = currentId
      ? document.querySelector<HTMLElement>(`[data-track] button[data-id="${currentId}"]`)
      : null;
    const target = current ?? lastFocus;
    if (target && document.contains(target)) target.focus();
    currentId = null;
    lastFocus = null;
  }

  function step(d: number) {
    if (!currentId) return;
    const n = order.indexOf(currentId) + d;
    if (n < 0 || n >= order.length) return;
    open(order[n]!, null);
    getTimelineApi()?.centerOn(order[n]!);
  }

  document.addEventListener(OPEN_EVENT, (e) => {
    const { id, origin } = (e as CustomEvent<{ id: string; origin: HTMLElement }>).detail;
    open(id, origin);
  });
  modal.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t === modal || t.closest('[data-close]')) close();
  });
  prevBtn.addEventListener('click', () => step(-1));
  nextBtn.addEventListener('click', () => step(1));

  document.addEventListener('keydown', (e) => {
    if (modal.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') step(1);
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'Tab') {
      // Foco preso no popup.
      const f = [...modal.querySelectorAll<HTMLElement>('button:not([disabled])')];
      if (!f.length) return;
      const first = f[0]!;
      const last = f[f.length - 1]!;
      if (!modal.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
      } else if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
