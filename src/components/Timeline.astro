---
// Casca estática da vista horizontal. Os nós da corda são criados no cliente
// (src/components/timeline/mount.ts) para que textos de eventos ocultos nunca entrem no DOM.
---
<section class="hz" id="timeline" data-timeline aria-label="Linha do tempo horizontal">
  <button type="button" class="hz-nav prev" data-prev aria-label="Voltar na linha do tempo">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button type="button" class="hz-nav next" data-next aria-label="Avançar na linha do tempo">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
  <div class="hz-scroll" id="linha-do-tempo" data-scroll tabindex="0" role="region" aria-label="Corda do tempo. Use as setas do teclado para rolar.">
    <div class="hz-track" data-track></div>
  </div>
  <div class="hz-prog" data-prog aria-hidden="true">
    <i></i>
    <svg class="ship-s" viewBox="0 0 40 40"><path class="s-hull" d="M6 27h28l-4 7H11z"/><path class="s-mast" d="M20 5v22"/><path class="s-sail" d="M21 7c8 4 10 10 10 17H21z"/><path class="s-jib" d="M19 10c-5 3-7 8-7 14h7z"/></svg>
  </div>
  <p class="hint">Arraste ou role para navegar. Com o teclado, Tab entra nos eventos e as setas ← → percorrem um a um (Enter abre). Passe o mouse nos pontos pequenos para ver o nome; clique em qualquer evento para abrir os detalhes.</p>
</section>

<script>
  import { data } from '../lib/data';
  import { store, setTimelineApi } from '../lib/app';
  import { mountTimeline } from './timeline/mount';

  const root = document.querySelector<HTMLElement>('[data-timeline]')!;
  setTimelineApi(mountTimeline(root, data, store));
</script>
